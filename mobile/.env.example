# Public mobile config only. Never put server secrets here.
RCT_METRO_PORT=8080
# Local rebuild API (default). Mac LAN IP — run: ipconfig getifaddr en0. Not localhost on a real phone.
EXPO_PUBLIC_API_URL=http://192.168.1.157:5217
