# Copy to ~/.config/getgrounded/apple/asc.env (never commit asc.env or .p8 files).
# App Store Connect → Users and Access → Integrations → App Store Connect API:
#   Issuer ID (top of page), Key ID PP97L7M8BF, download .p8 once.
# Apple Developer → Membership → Team ID.

export EXPO_ASC_API_KEY_PATH="$HOME/.config/getgrounded/apple/AuthKey_PP97L7M8BF.p8"
export EXPO_ASC_KEY_ID="PP97L7M8BF"
export EXPO_ASC_ISSUER_ID="8c5e78ea-9306-42a7-b230-1794a69cb458"
export EXPO_APPLE_TEAM_ID="UK6DP5RV7F"
export EXPO_APPLE_TEAM_TYPE="INDIVIDUAL"
export EXPO_NO_CAPABILITY_SYNC=1
