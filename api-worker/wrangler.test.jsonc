{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "get-grounded-api-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": ["nodejs_compat"],
	"ratelimits": [
		{
			"name": "GLOBAL_RATE_LIMITER",
			"namespace_id": "882001",
			"simple": {
				"limit": 2400,
				"period": 60
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GETGROUNDED_API",
				"class_name": "GetGroundedApiContainer"
			}
		]
	},
	"exports": {
		"GetGroundedApiContainer": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
