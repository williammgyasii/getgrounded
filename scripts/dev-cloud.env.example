# On this Mac the Cloudflare token already lives at ~/.config/cloudflare/env
# (chmod 600, sourced from ~/.zshrc). New terminals have it.
# For a one-off shell: source ~/.config/cloudflare/env
#
# Identifiers (not secrets):
export CLOUDFLARE_ACCOUNT_ID=e23518956f08ff35812d9ab001a39880
export GOOGLE_CLOUD_PROJECT=get-ground-448ca

# Secrets — create these in the dashboards, never paste them into chat.
# Also add the same values as GitHub environment "dev" secrets.

# Cloudflare Global API Key uses email + key (not Bearer). Already in ~/.config/cloudflare/env.
# export CLOUDFLARE_EMAIL=
# export CLOUDFLARE_API_KEY=

# Cloudflare → R2 → Manage API tokens → Object Read & Write on getgrounded-tfstate only
# Terraform's S3 backend expects the AWS names. GitHub secret names stay R2_*.
# export AWS_ACCESS_KEY_ID=
# export AWS_SECRET_ACCESS_KEY=
